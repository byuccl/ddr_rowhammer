{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Rowhammer",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--nrows",
                "512",
                "--read_count",
                "10e6",
                "--pattern",
                "01_in_row",
                "--row-pairs",
                "const",
                "--const-rows-pair",
                "54",
                "133",
                "--no-refresh"
            ]
        }
    ]
}