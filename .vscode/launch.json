{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "ECC Test Direct",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/litedram",
            "justMyCode": true
        },
        {
            "name": "ECC Test",
            "type": "python",
            "request": "launch",
            "module": "unittest",
            "cwd": "${workspaceFolder}/litedram",
            "args": [
                "test.test_ecc"
            ],
            "justMyCode": true
        },
        {
            "name": "Nexys Video",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--uart-name=usb_fifo",
                "--build"
            ],
            "justMyCode": false
        },
    ]
}